#!/usr/bin/env bash
# post-commit: no fim de um bloco de trabalho, lembra de exportar a sessão do Claude Code (regra 3).
# Só avisa: não exporta, não cria commits, não altera arquivos.
#
# Fim de bloco = qualquer commit, exceto:
#   - feat|test|fix|refactor(T-NNN): meio da task; o bloco fecha no "docs(tasks): conclui T-NNN"
#   - docs(sessions): é o próprio export
#
# Uso: chamado pelo git (texto no terminal) ou com --json pelo hook do Claude Code.
cd "$(git rev-parse --show-toplevel)" || exit 0
subject=$(git log -1 --format=%s 2>/dev/null) || exit 0

if [[ "$subject" =~ ^(feat|test|fix|refactor)\(T-[0-9]{3}\): ]] || [[ "$subject" == docs\(sessions\):* ]]; then
  exit 0
fi

last=$(ls docs/sessions/ 2>/dev/null | grep -oE '^[0-9]{2}' | sort -n | tail -1)
next=$(printf '%02d' $((10#${last:-0} + 1)))

msg="📝 Fim do bloco de trabalho (\"$subject\"). Exporte a sessão antes de continuar:
   /export docs/sessions/${next}-<descricao-curta>.md
   e commite com: docs(sessions): export da sessão ${next}"

if [ "${1:-}" = "--json" ]; then
  jq -n --arg msg "$msg" '{
    systemMessage: $msg,
    hookSpecificOutput: {
      hookEventName: "PostToolUse",
      additionalContext: ("Lembrete de export exibido ao usuário: " + $msg + "\nNão inicie o próximo bloco de trabalho por conta própria; deixe o usuário exportar ou decidir seguir.")
    }
  }'
else
  printf '\n%s\n\n' "$msg"
fi
